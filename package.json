{
  "name": "@withakay/opencode-autopilot",
  "version": "1.0.0-beta.1",
  "description": "Autopilot plugin for OpenCode - autonomous multi-step task continuation slop generator",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tui": {
      "import": "./dist/tui.js",
      "types": "./dist/tui.d.ts"
    },
    "./rpc": {
      "import": "./dist/rpc.js",
      "types": "./dist/rpc.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    ".opencode/agents/*.md",
    ".opencode/wingman-config.json",
    ".opencode/wingman-config.schema.json"
  ],
  "scripts": {
    "build": "bun build ./index.ts ./tui.ts ./rpc.ts --outdir ./dist --target bun --sourcemap --external '@opencode-ai/*' --external effect --external solid-js --external '@opentui/*'",
    "typecheck": "tsc --noEmit",
    "test": "bun test ./__tests__/",
    "lint": "biome check .",
    "format": "biome format . --write",
    "check": "bun run lint && bun run typecheck",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "opencode",
    "autopilot",
    "agent",
    "automation",
    "ai",
    "coding"
  ],
  "author": "Withakay",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/withakay/opencode-autopilot.git"
  },
  "bugs": {
    "url": "https://github.com/withakay/opencode-autopilot/issues"
  },
  "homepage": "https://github.com/withakay/opencode-autopilot#readme",
  "dependencies": {
    "@opencode-ai/plugin": "beta"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "@opencode-ai/client": "^0.0.0-beta-19135",
    "bun-types": "^1.3.14",
    "effect": "4.0.0-rc.112",
    "typescript": "^6.0.3"
  }
}
